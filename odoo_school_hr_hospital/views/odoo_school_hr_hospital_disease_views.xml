<odoo>
    <record id="os_hr_hospital_disease_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.disease.list</field>
        <field name="model">os.hr.hospital.disease</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name"/>
                <field name="code"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="os_hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.disease.form</field>
        <field name="model">os.hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Child Diseases">
                            <field name="child_ids">
                                <list>
                                    <field name="display_name"/>
                                    <field name="code"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="doctor_id"/>
                                    <field name="state"/>
                                    <field name="scheduled_datetime"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="os_hr_hospital_disease_search" model="ir.ui.view">
        <field name="name">os.hr.hospital.disease.search</field>
        <field name="model">os.hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <searchpanel view_types="list">
                    <field name="parent_id"
                           string="Diseases"
                           select="one"
                           hierarchize="1"
                           expand="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="os_hr_hospital_action_disease_window" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.disease</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="os_hr_hospital_disease_search"/>
    </record>

    <menuitem id="os_hr_hospital_menu_disease"
              action="os_hr_hospital_action_disease_window"
              parent="os_hr_hospital_main_menu"
              name="Diseases" sequence="300"/>
</odoo>
