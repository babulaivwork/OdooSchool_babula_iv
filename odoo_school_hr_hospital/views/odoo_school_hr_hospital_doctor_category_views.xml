<odoo>
    <record id="odoo_school_hr_hospital_doctor_category_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.category.list</field>
        <field name="model">os.hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_doctor_category_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.category.form</field>
        <field name="model">os.hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <field name="doctor_ids">
                        <list>
                            <field name="name"/>
                            <field name="specialty"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_hr_hospital_doctor_category_window" model="ir.actions.act_window">
        <field name="name">Doctor Qualifications</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="odoo_school_hr_hospital_menu_doctor_category"
              action="action_odoo_school_hr_hospital_doctor_category_window"
              parent="odoo_school_hr_hospital_main_menu"
              name="Doctor Qualifications" sequence="500"/>
</odoo>
