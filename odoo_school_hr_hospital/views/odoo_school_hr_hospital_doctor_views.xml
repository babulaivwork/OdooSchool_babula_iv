<odoo>
    <record id="os_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.list</field>
        <field name="model">os.hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="os_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.form</field>
        <field name="model">os.hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="category_id"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"
                                   domain="[('is_intern', '=', False)]"
                                   invisible="not is_intern"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="disease_id"/>
                                    <field name="state"/>
                                    <field name="scheduled_datetime"/>
                                </list>
                            </field>
                        </page>
                        <page name="interns"
                              string="Interns"
                              invisible="not intern_ids">
                            <field name="intern_ids" readonly="1">
                                <kanban create="false"
                                        edit="false"
                                        delete="false"
                                        records_draggable="false">
                                    <field name="name"/>
                                    <field name="specialty"/>
                                    <field name="category_id"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <templates>
                                        <t t-name="card">
                                            <div class="d-flex flex-column gap-1">
                                                <field name="name" class="fw-bold fs-5"/>
                                                <field name="category_id"/>
                                                <field name="specialty"/>
                                                <field name="phone"/>
                                                <field name="email"/>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="os_hr_hospital_doctor_search" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.search</field>
        <field name="model">os.hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <filter name="mentors"
                        string="Mentors"
                        domain="[('intern_ids', '!=', False)]"/>
                <filter name="interns"
                        string="Interns"
                        domain="[('is_intern', '=', True)]"/>
            </search>
        </field>
    </record>

    <record id="os_hr_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.kanban</field>
        <field name="model">os.hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id"
                    group_delete="false">
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="mentor_id"/>
                <field name="is_intern"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-column gap-1">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="specialty"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <div t-if="record.mentor_id.raw_value">
                                <span class="fw-bold">Mentor: </span>
                                <field name="mentor_id"/>
                            </div>
                            <footer class="mt-2">
                                <button name="action_create_visit"
                                        string="Create Visit"
                                        type="object"
                                        class="btn btn-primary"/>
                            </footer>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="os_hr_hospital_action_doctor_window" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.doctor</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="os_hr_hospital_doctor_search"/>
    </record>

    <menuitem id="os_hr_hospital_menu_doctor"
              action="os_hr_hospital_action_doctor_window"
              parent="os_hr_hospital_main_menu"
              name="Doctors" sequence="100"/>
</odoo>
