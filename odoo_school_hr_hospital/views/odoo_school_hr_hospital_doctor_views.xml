<odoo>
    <record id="odoo_school_hr_hospital_doctor_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.list</field>
        <field name="model">os.hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="specialty"/>
                <field name="category_id"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.form</field>
        <field name="model">os.hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="specialty"/>
                            <field name="category_id"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"
                                   domain="[('is_intern', '=', False)]"
                                   invisible="not is_intern"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="patient_id"/>
                                    <field name="disease_id"/>
                                    <field name="state"/>
                                    <field name="scheduled_datetime"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_hr_hospital_doctor_window" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.doctor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="odoo_school_hr_hospital_menu_doctor"
              action="action_odoo_school_hr_hospital_doctor_window"
              parent="odoo_school_hr_hospital_main_menu"
              name="Doctors" sequence="100"/>
</odoo>
