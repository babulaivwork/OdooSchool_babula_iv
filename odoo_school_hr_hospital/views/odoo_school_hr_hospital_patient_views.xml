<odoo>
    <record id="odoo_school_hr_hospital_patient_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.patient.list</field>
        <field name="model">os.hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="birth_date"/>
                <field name="phone"/>
                <field name="email"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.patient.form</field>
        <field name="model">os.hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_create_visit"
                            string="Create Visit"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-calendar">
                            <field name="visit_count"
                                   string="Visits"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                            <field name="blood_group"/>
                            <field name="personal_doctor_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                            <field name="insurance_policy_number"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Visits">
                            <field name="visit_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="doctor_id"/>
                                    <field name="disease_id"/>
                                    <field name="state"/>
                                    <field name="scheduled_datetime"/>
                                </list>
                            </field>
                        </page>
                        <page string="Personal Doctor History">
                            <field name="doctor_history_ids">
                                <list>
                                    <field name="doctor_id"/>
                                    <field name="assignment_date"/>
                                    <field name="change_date"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">os.hr.hospital.patient.search</field>
        <field name="model">os.hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
            </search>
        </field>
    </record>

    <record id="action_odoo_school_hr_hospital_patient_window" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="odoo_school_hr_hospital_patient_search"/>
    </record>

    <menuitem id="odoo_school_hr_hospital_menu_patient"
              action="action_odoo_school_hr_hospital_patient_window"
              parent="odoo_school_hr_hospital_main_menu"
              name="Patients" sequence="200"/>
</odoo>
