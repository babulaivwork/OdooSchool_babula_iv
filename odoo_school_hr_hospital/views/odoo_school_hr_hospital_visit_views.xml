<odoo>
    <record id="odoo_school_hr_hospital_visit_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.list</field>
        <field name="model">os.hr.hospital.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="state"/>
                <field name="scheduled_datetime"/>
                <field name="actual_datetime"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.form</field>
        <field name="model">os.hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="scheduled,completed,cancelled"
                           options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_disease_visits"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-stethoscope"
                                invisible="not disease_id">
                            <field name="disease_visit_count"
                                   string="Disease Visits"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="patient_id"/>
                            <field name="doctor_id" readonly="state == 'completed'"/>
                            <field name="disease_id"/>
                        </group>
                        <group>
                            <field name="scheduled_datetime" readonly="state == 'completed'"/>
                            <field name="actual_datetime" readonly="state == 'completed'"/>
                            <field name="active" readonly="state == 'completed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Summary">
                            <field name="summary"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.calendar</field>
        <field name="model">os.hr.hospital.visit</field>
        <field name="arch" type="xml">
            <calendar string="Visits"
                      date_start="scheduled_datetime"
                      color="doctor_id"
                      quick_create="0"
                      event_open_popup="true">
                <field name="patient_id"/>
                <field name="doctor_id" filters="1"/>
                <field name="disease_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_visit_search" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.search</field>
        <field name="model">os.hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="scheduled_datetime"/>
                <filter name="current_year"
                        string="Current Year"
                        date="scheduled_datetime"
                        default_period="year"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
                <searchpanel view_types="list">
                    <field name="doctor_id"
                           select="multi"
                           enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.pivot</field>
        <field name="model">os.hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot string="Visits" display_quantity="1">
                <field name="doctor_id" type="row"/>
                <field name="scheduled_datetime" type="row" interval="month"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_visit_graph" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.graph</field>
        <field name="model">os.hr.hospital.visit</field>
        <field name="arch" type="xml">
            <graph string="Visits by Month and Disease" type="bar" stacked="1">
                <field name="scheduled_datetime" interval="month"/>
                <field name="disease_id"/>
            </graph>
        </field>
    </record>

    <record id="action_odoo_school_hr_hospital_visit_window" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.visit</field>
        <field name="view_mode">list,form,calendar,pivot,graph</field>
        <field name="search_view_id" ref="odoo_school_hr_hospital_visit_search"/>
        <field name="context">{'search_default_current_year': 1}</field>
    </record>

    <menuitem id="odoo_school_hr_hospital_menu_visit"
              action="action_odoo_school_hr_hospital_visit_window"
              parent="odoo_school_hr_hospital_main_menu"
              name="Visits" sequence="400"/>
</odoo>
