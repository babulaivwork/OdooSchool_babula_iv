<odoo>
    <record id="odoo_school_hr_hospital_doctor_history_list" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.history.list</field>
        <field name="model">os.hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="assignment_date"/>
                <field name="change_date"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="odoo_school_hr_hospital_doctor_history_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.doctor.history.form</field>
        <field name="model">os.hr.hospital.doctor.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="assignment_date"/>
                            <field name="change_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_hr_hospital_doctor_history_window" model="ir.actions.act_window">
        <field name="name">Personal Doctor History</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">os.hr.hospital.doctor.history</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="odoo_school_hr_hospital_menu_doctor_history"
              action="action_odoo_school_hr_hospital_doctor_history_window"
              parent="odoo_school_hr_hospital_main_menu"
              name="Personal Doctor History" sequence="600"/>
</odoo>
