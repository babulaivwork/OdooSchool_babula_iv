<odoo>
    <record id="odoo_school_hr_hospital_visit_report_wizard_form" model="ir.ui.view">
        <field name="name">os.hr.hospital.visit.report.wizard.form</field>
        <field name="model">os.hr.hospital.visit.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Visit Report">
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags"/>
                        <field name="patient_ids" widget="many2many_tags"/>
                        <field name="disease_id"/>
                    </group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="only_completed"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate_report"
                            type="object"
                            string="Generate Report"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odoo_school_hr_hospital_visit_report_wizard_patient" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">os.hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="odoo_school_hr_hospital_visit_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_os_hr_hospital_patient"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="action_odoo_school_hr_hospital_visit_report_wizard_doctor" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">os.hr.hospital.visit.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="odoo_school_hr_hospital_visit_report_wizard_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_os_hr_hospital_doctor"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
